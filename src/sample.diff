 use std::env;

-/// Prints a greeting.
-fn greet(name: &str) {
-    println!("Hello, {name}!");
+/// Returns a greeting, shouted when `loud` is set.
+fn greet(name: &str, loud: bool) -> String {
+    let greeting = format!("Hello, {name}!");
+    if loud { greeting.to_uppercase() } else { greeting }
 }

 fn main() {
-    let name = env::args().nth(1).unwrap_or_else(|| "world".into());
-    greet(&name);
+    let mut args = env::args().skip(1);
+    let name = args.next().unwrap_or_else(|| "world".into());
+    // `--loud` anywhere after the name.
+    let loud = args.any(|a| a == "--loud");
+    println!("{}", greet(&name, loud));
 }
