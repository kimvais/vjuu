{
  "description": "Review Claude Code plans, questions, permission prompts and each turn's edits in vjuu, and send back turns that end in a prose question; switch each with `vjuu config`",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [{ "type": "command", "command": "vjuu", "args": ["hook", "plan"], "timeout": 3600 }]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "vjuu", "args": ["hook", "ask"], "timeout": 3600 }]
      }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "vjuu", "args": ["hook", "permission"], "timeout": 3600 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "vjuu", "args": ["hook", "turn"], "timeout": 3600 }] },
      { "hooks": [{ "type": "command", "command": "vjuu", "args": ["hook", "gate"], "timeout": 10 }] }
    ]
  }
}
