{
  "description": "Review Claude Code plans, questions and each turn's edits in vjuu; switch each with `vjuu config`",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [{ "type": "command", "command": "vjuu", "args": ["hook", "plan"], "timeout": 3600 }]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "vjuu", "args": ["hook", "ask"], "timeout": 3600 }]
      }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "vjuu", "args": ["hook", "turn"], "timeout": 3600 }] }]
  }
}
